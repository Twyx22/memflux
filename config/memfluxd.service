[Unit]
Description=memflux — optimiseur mémoire adaptatif (pageout sélectif, working-set sampling)
Documentation=man:memfluxd(8)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/memfluxd -c /etc/memflux.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# process_madvise(MADV_PAGEOUT) nécessite CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_ADMIN
# /proc/pagemap nécessite un accès privilégié sur les autres processus
ProtectSystem=strict
ReadWritePaths=/var/log /run
PrivateTmp=no
ProtectHome=yes
NoNewPrivileges=no
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target